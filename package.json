{
  "name": "Docker to VM",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "generate:db": "cd packages/db/prisma && bunx prisma generate",
    "start:web": "cd apps/web && bun run index.ts",
    "start:backend": "cd apps/backend && bun run index.ts",
    "start:ws": "cd apps/websockets && bun run index.ts"

  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@types/express": "^5.0.3",
    "express": "^5.1.0"
  }
}
